#!/usr/bin/env bash
# =============================================================================
# openclaw-bg — OpenClaw Gateway 后台管理工具
#
# 用法: openclaw-bg start [参数...]
#       openclaw-bg stop
#       openclaw-bg status
#       openclaw-bg uninstall
# =============================================================================
set -euo pipefail

# ---- 确保 Git Bash 工具在 PATH 中（防止通过 .cmd wrapper 调用时 PATH 缺失） ----
export PATH="/usr/bin:/mingw64/bin:$PATH"

# ---- 确定项目根目录 ----
if [[ -n "${OPENCLAW_BG_HOME:-}" ]]; then
    PROJECT_DIR="$OPENCLAW_BG_HOME"
else
    PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

# ---- 路径定义 ----
STATE_DIR="${OPENCLAW_STATE_DIR:-$HOME/.openclaw}"
PID_FILE="$STATE_DIR/gateway.pid"
LOG_DIR="$PROJECT_DIR/logs"
GATEWAY_LOG="$LOG_DIR/gateway.log"
EVENT_LOG="$LOG_DIR/openclaw-bg.log"
WRAPPER_FILE="$PROJECT_DIR/.wrapper-path"

# ---- 日志函数 ----
log_event() {
    local level="$1" msg="$2"
    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    mkdir -p "$LOG_DIR"
    echo "[$timestamp] [$level] $msg" >> "$EVENT_LOG"
}

# ---- 检测是否已运行 ----
is_running() {
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid="$(cat "$PID_FILE")"
        if kill -0 "$pid" 2>/dev/null; then
            echo "$pid"
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

# ---- 终止进程 ----
stop_process() {
    local pid="$1"
    if kill "$pid" 2>/dev/null; then
        for _ in $(seq 1 10); do
            if ! kill -0 "$pid" 2>/dev/null; then
                return 0
            fi
            sleep 1
        done
        kill -9 "$pid" 2>/dev/null || true
    fi
    return 0
}

# ============================
# 子命令: start
# ============================
cmd_start() {
    mkdir -p "$STATE_DIR" "$LOG_DIR"

    if pid=$(is_running); then
        echo "OpenClaw Gateway 已在运行中 (PID: $pid)"
        log_event "start" "已在运行 (PID: $pid), 跳过"
        return 0
    fi

    echo "正在后台启动 OpenClaw Gateway..."
    log_event "start" "开始启动 (参数: ${*:-无})"

    nohup openclaw gateway run "$@" >> "$GATEWAY_LOG" 2>&1 &
    local bg_pid=$!
    echo $bg_pid > "$PID_FILE"

    echo "OpenClaw Gateway 已启动 (PID: $bg_pid)"
    echo "运行日志: $GATEWAY_LOG"
    log_event "start" "启动成功 (PID: $bg_pid)"
}

# ============================
# 子命令: stop
# ============================
cmd_stop() {
    mkdir -p "$LOG_DIR"

    if [[ ! -f "$PID_FILE" ]]; then
        echo "OpenClaw Gateway 未在运行（PID 文件不存在）"
        log_event "stop" "PID 文件不存在，无需停止"
        return 0
    fi

    local pid
    pid="$(cat "$PID_FILE")"

    if ! kill -0 "$pid" 2>/dev/null; then
        echo "OpenClaw Gateway 未在运行（进程 $pid 已不存在）"
        rm -f "$PID_FILE"
        log_event "stop" "进程 $pid 已不存在，清理 PID"
        return 0
    fi

    echo "正在停止 OpenClaw Gateway (PID: $pid)..."
    log_event "stop" "开始停止 (PID: $pid)"
    stop_process "$pid"
    rm -f "$PID_FILE"
    echo "OpenClaw Gateway 已停止"
    log_event "stop" "停止成功 (PID: $pid)"
}

# ============================
# 子命令: status
# ============================
cmd_status() {
    if pid=$(is_running); then
        echo "OpenClaw Gateway 运行中 (PID: $pid)"
        echo "运行日志: $GATEWAY_LOG"
    else
        echo "OpenClaw Gateway 未运行"
    fi
}

# ============================
# 子命令: uninstall
# ============================
cmd_uninstall() {
    echo "正在卸载 OpenClaw BG..."

    # 停止 Gateway
    if pid=$(is_running); then
        echo "  停止运行中的 Gateway (PID: $pid)..."
        stop_process "$pid"
        rm -f "$PID_FILE"
    fi

    # 找到并删除 wrapper
    local wrapper=""
    if [[ -f "$WRAPPER_FILE" ]]; then
        wrapper="$(cat "$WRAPPER_FILE")"
        echo "  移除命令: $wrapper"
        rm -f "$wrapper"
    fi

    # 额外搜索 PATH 中的 wrapper
    local found
    found="$(which openclaw-bg 2>/dev/null || true)"
    if [[ -n "$found" ]] && [[ "$found" != "$PROJECT_DIR/bin/openclaw-bg" ]]; then
        echo "  移除命令: $found"
        rm -f "$found"
    fi
    # Windows .cmd wrapper
    found="$(which openclaw-bg.cmd 2>/dev/null || true)"
    if [[ -n "$found" ]]; then
        echo "  移除命令: $found"
        rm -f "$found"
    fi

    # 清理状态文件
    rm -f "$PID_FILE"

    # 后台删除项目目录（当前进程还在使用）
    echo "  清理项目文件..."
    (sleep 1; rm -rf "$PROJECT_DIR") &

    echo ""
    echo "OpenClaw BG 已卸载"
    log_event "uninstall" "卸载完成"
}

# ============================
# 子命令: help
# ============================
cmd_help() {
    echo "OpenClaw BG — OpenClaw Gateway 后台管理工具"
    echo ""
    echo "用法: openclaw-bg <命令> [参数...]"
    echo ""
    echo "命令:"
    echo "  start [参数...]  后台启动 OpenClaw Gateway"
    echo "                    参数会透传给 openclaw gateway run"
    echo "  stop             停止 OpenClaw Gateway"
    echo "  status           查看 Gateway 运行状态"
    echo "  uninstall        卸载 OpenClaw BG"
    echo "  help             显示此帮助信息"
    echo ""
    echo "示例:"
    echo "  openclaw-bg start"
    echo "  openclaw-bg start --port 18789 --verbose"
    echo "  openclaw-bg stop"
    echo "  openclaw-bg status"
    echo "  openclaw-bg uninstall"
}

# ============================
# 入口
# ============================
case "${1:-}" in
    start)
        shift
        cmd_start "$@"
        ;;
    stop)
        cmd_stop
        ;;
    status)
        cmd_status
        ;;
    uninstall)
        cmd_uninstall
        ;;
    help|-h|--help)
        cmd_help
        ;;
    *)
        echo "错误: 未知命令 '${1:-}'" >&2
        echo "使用 'openclaw-bg help' 查看帮助" >&2
        exit 1
        ;;
esac
